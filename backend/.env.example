# Copy to .env and adjust. Defaults work for local development.

SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///./data/notecast.db
DEBUG=true

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=120
ALGORITHM=HS256

# Local file storage
UPLOAD_DIR=./data/uploads
PODCAST_DIR=./data/podcasts

# Ollama — install from https://ollama.com then: ollama pull llama3.2
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# TTS: "edge" needs only ffmpeg (no GPU). "nemo" needs CUDA + requirements-gpu.txt
TTS_ENGINE=edge
TTS_VOICE_FEMALE=en-US-AriaNeural
TTS_VOICE_MALE=en-US-GuyNeural

# Extra CORS origins, comma-separated (localhost:5173 is always allowed)
# CORS_ORIGINS=https://your-frontend.example
